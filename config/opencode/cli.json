{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app.exit": "ctrl+q",
    "input.newline": "shift+return,ctrl+return,alt+return"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  }
}
