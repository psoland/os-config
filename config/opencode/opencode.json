{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "sol",
  "warming": {
    "interval": "4 minutes",
    "duration": "30 minutes"
  },
  "providers": {
    "openai": {
      "models": {
        // Explicit limits override the smaller ChatGPT/Codex defaults.
        "gpt-6.1-sol": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6.1-sol-fast": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6.1-sol-ultrafast": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6-astra": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6-astra-fast": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6-astra-ultrafast": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6-luna": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        },
        "gpt-6-luna-fast": {
          "limit": { "context": 1050000, "input": 922000, "output": 128000 }
        }
      }
    },
    "knowit-ai-gateway": {
      "name": "Knowit AI Gateway",
      "env": ["AGW_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.aiservices.knowit.no/v1"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "*.env.schema": "allow"
    },
    "external_directory": "allow"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "astra": {
      "description": "Most capable agent for orchestration, ambiguous goals, architecture, and difficult reasoning. Use to decompose work and resolve conflicting evidence; delegate routine execution.",
      "mode": "all",
      "model": "openai/gpt-6-astra",
      "variant": "medium",
      "permission": "allow"
    },
    "luna": {
      "description": "Primary development agent with max reasoning. For delegated execution, use luna-worker instead.",
      "mode": "all",
      "model": "openai/gpt-6-luna",
      "variant": "max",
      "permission": "allow"
    },
    "luna-worker": {
      "description": "Low-cost worker for precise, easily verified tasks: mechanical edits, bounded lookups, extraction, specified checks, and authorized commits. Report unexpected complexity for escalation to Sol.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "permission": "allow"
    },
    "sol": {
      "description": "Research, debugging, and development requiring discovery, evidence synthesis, or implementation decisions. Use when the goal is clear but the approach or solution is not.",
      "mode": "all",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": "allow"
    }
  },
  // Keep the global policy unset so built-in agent restrictions remain effective.
  // "read": {
  //   "*": "allow",
  //   "*.env": "deny",
  //   "*.env.*": "deny",
  //   "*.env.example": "allow"
  // },
  // "external_directory": {
  //   "~/.dotfiles/**": "allow",
  //   "~/.config/**": "allow",
  //   "~/.local/**": "allow"
  // },
  // "skill": {
  //   "*": "allow",
  //   "better-auth-*": "allow",
  //   "experimental-*": "ask",
  //   "web-design-guidlines": "deny"
  // }
  // },
  "mcp": {
    // "servers": {
    //   "research": {
    //     "type": "remote",
    //     "url": "https://research.joexbayer.dev/mcp",
    //     "oauth": false,
    //     "headers": {
    //       "Authorization": "Bearer {file:~/.config/research-engine/token}"
    //     }
    //   }
    // },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "sideshow": {
      "type": "remote",
      "url": "https://sideshow.sh/mcp",
      "enabled": false
    },
    "executor": {
      "type": "remote",
      "url": "https://executor.sh/mujo/mcp",
      "enabled": true
    },
    "tripletex": {
      "type": "remote",
      "url": "https://mcp.tripletex.no",
      "enabled": false
    },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"],
      "enabled": false
    }
    // "sideshow": {
    //   "type": "remote",
    //   "url": "https://sideshow.sh/psoland/mcp",
    //   "enabled": true,
    //   "headers": {
    //     "Authorization": "Bearer {env:SIDESHOW_TOKEN}"
    //   }
    // }
  }
}
