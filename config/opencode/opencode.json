  // "skill": {
  //   "*": "allow",
  //   "better-auth-*": "allow",
  //   "experimental-*": "ask",
  //   "web-design-guidlines": "deny"
  // }
  // },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "sideshow": {
      "type": "remote",
      "url": "https://sideshow.sh/mcp",
      "enabled": false
    },
    "executor": {
      "type": "remote",
      "url": "https://executor.sh/mujo/mcp",
      "enabled": true
    },
    "tripletex": {
      "type": "remote",
      "url": "https://mcp.tripletex.no",
      "enabled": false
    },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"],
      "enabled": false
    }
    // "sideshow": {
