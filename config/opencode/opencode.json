  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "sideshow": {
      "type": "remote",
      "url": "https://sideshow.sh/mcp",
      "enabled": true
    },
    "executor": {
      "type": "remote",
      "url": "https://executor.sh/mujo/mcp",
      "enabled": true
    },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"],
      "enabled": true
    }
    // "sideshow": {
